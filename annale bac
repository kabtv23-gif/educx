<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EDUCX — Annales & Sujets 2020-2026</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
    <style>
        :root{--bg:#07080f;--surface:#0f1120;--surface2:#171929;--border:rgba(255,255,255,0.08);--accent:#5b6ef8;--accent2:#f85b9e;--accent3:#5bf8c4;--gold:#f8c25b;--muted:#6b7280;--text:#e8eaf6;}
        *{margin:0;padding:0;box-sizing:border-box;}
        body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;overflow-x:hidden;line-height:1.6;}
        
        /* Background Blobs */
        .blob{position:fixed;border-radius:50%;filter:blur(120px);z-index:0;opacity:0.1;pointer-events:none;}
        .blob-1{width:500px;height:500px;background:var(--accent);top:-150px;left:-150px;}
        .blob-2{width:400px;height:400px;background:var(--accent2);bottom:-100px;right:-100px;}

        nav{position:fixed;top:0;left:0;right:0;z-index:1000;padding:0 32px;height:68px;display:flex;align-items:center;justify-content:space-between;background:rgba(7,8,15,0.8);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);}
        .logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1.5rem;background:linear-gradient(135deg,var(--accent),var(--accent3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-decoration:none;}
        
        .container{max-width:1200px;margin:0 auto;padding:100px 24px 60px;position:relative;z-index:1;}

        /* Header */
        .page-header{text-align:center;margin-bottom:40px;}
        .page-title{font-family:'Syne',sans-serif;font-size:2.8rem;font-weight:800;margin-bottom:10px;}
        .page-title span{background:linear-gradient(135deg,var(--accent),var(--accent3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}

        /* Filters */
        .filters-container{background:var(--surface);padding:20px;border-radius:20px;border:1px solid var(--border);margin-bottom:40px;}
        .filter-row{display:flex;align-items:center;gap:15px;flex-wrap:wrap;margin-bottom:15px;}
        .filter-row:last-child{margin-bottom:0;}
        .filter-label{font-size:0.7rem;font-weight:800;text-transform:uppercase;color:var(--muted);width:80px;}
        .fbtn{padding:8px 16px;border-radius:50px;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:0.8rem;font-weight:600;cursor:pointer;transition:0.2s;}
        .fbtn.active{background:var(--accent);color:white;border-color:var(--accent);}
        .search-input{flex:1;background:var(--surface2);border:1px solid var(--border);padding:10px 15px;border-radius:12px;color:white;outline:none;}

        /* Grid */
        .sujets-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:20px;}
        .card{background:var(--surface);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:0.3s;}
        .card:hover{transform:translateY(-5px);border-color:var(--accent);}
        .card-body{padding:20px;}
        
        /* Subject specific colors */
        .bar-maths{height:4px;background:var(--accent);}
        .bar-physique{height:4px;background:var(--accent2);}
        .bar-chimie{height:4px;background:var(--accent3);}

        .tag{padding:3px 10px;border-radius:50px;font-size:0.65rem;font-weight:800;margin-right:5px;display:inline-block;margin-bottom:8px;}
        .tag-bac{background:rgba(91,110,248,0.1);color:var(--accent);}
        .tag-brevet{background:rgba(248,91,158,0.1);color:var(--accent2);}
        .tag-year{background:rgba(248,194,91,0.1);color:var(--gold);}

        .card-title{font-family:'Syne',sans-serif;font-size:1.1rem;font-weight:700;margin-bottom:8px;}
        .card-desc{font-size:0.85rem;color:var(--muted);margin-bottom:15px;}
        
        .preview-box{background:var(--surface2);padding:12px;border-radius:12px;margin-bottom:15px;}
        .preview-item{font-size:0.75rem;display:flex;gap:8px;margin-bottom:4px;}
        .q-num{color:var(--accent);font-weight:bold;}

        .card-footer{padding:15px 20px;border-top:1px solid var(--border);display:flex;gap:10px;}
        .btn{flex:1;padding:10px;border-radius:10px;text-align:center;text-decoration:none;font-size:0.8rem;font-weight:700;transition:0.2s;}
        .btn-main{background:var(--accent);color:white;}
        .btn-sub{background:var(--surface2);color:var(--text);border:1px solid var(--border);}

        @media(max-width:768px){.page-title{font-size:2rem;}.filter-label{width:100%;}}
    </style>
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <nav>
        <a href="#" class="logo">EDUCX</a>
        <div class="nav-right">
            <span style="font-size:0.8rem;color:var(--accent3);font-weight:bold;">● Mode Examen 2026</span>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <div class="page-title">Annales <span>2020 — 2026</span></div>
            <p style="color:var(--muted)">Accédez aux sujets officiels de Métropole et Hors-Métropole (Asie, Amérique, Liban).</p>
        </div>

        <div class="filters-container">
            <div class="filter-row">
                <span class="filter-label">Examen</span>
                <button class="fbtn active" onclick="filterType('tout', this)">Tout</button>
                <button class="fbtn" onclick="filterType('bac', this)">Bac Pro/Général</button>
                <button class="fbtn" onclick="filterType('brevet', this)">Brevet (DNB)</button>
            </div>
            <div class="filter-row">
                <span class="filter-label">Matière</span>
                <button class="fbtn active" onclick="filterMat('tout', this)">Toutes</button>
                <button class="fbtn" onclick="filterMat('maths', this)">Mathématiques</button>
                <button class="fbtn" onclick="filterMat('physique', this)">Physique</button>
                <button class="fbtn" onclick="filterMat('chimie', this)">Chimie</button>
            </div>
            <div class="filter-row">
                <input type="text" class="search-input" id="searchBar" placeholder="Rechercher un thème (ex: Probabilités, Newton, pH...)" onkeyup="search()">
            </div>
        </div>

        <div class="sujets-grid" id="grid">
            </div>
    </div>

    <script>
        const DATA = [
            { id: 1, type: 'bac', mat: 'maths', annee: 2026, zone: 'Métropole', titre: 'Bac Maths 2026 (Sujet Zéro)', desc: 'Anticipation des nouvelles modalités : Analyse complexe et Géométrie spatiale.', questions: ['Suites convergentes', 'Loi Binomiale', 'Produit scalaire'], themes: 'suites probabilités' },
            { id: 2, type: 'bac', mat: 'physique', annee: 2025, zone: 'Centres Étrangers', titre: 'Bac Physique 2025 — Liban', desc: 'Mouvement de projectiles et étude de l\'effet Doppler.', questions: ['Mécanique céleste', 'Ondes sonores', 'Circuit RC'], themes: 'mécanique ondes' },
            { id: 3, type: 'brevet', mat: 'maths', annee: 2024, zone: 'Métropole', titre: 'Brevet Maths 2024', desc: 'Épreuve complète incluant l\'exercice de programmation Scratch.', questions: ['Théorème de Thalès', 'Calcul littéral', 'Algorithmique'], themes: 'géométrie scratch' },
            { id: 4, type: 'bac', mat: 'chimie', annee: 2024, zone: 'Amérique du Nord', titre: 'Bac Chimie 2024', desc: 'Cinétique chimique et titrage des ions ferreux.', questions: ['Équilibre chimique', 'Spectroscopie IR', 'Vitesse de réaction'], themes: 'titrage cinétique' },
            { id: 5, type: 'brevet', mat: 'physique', annee: 2023, zone: 'Asie', titre: 'Brevet Sciences 2023', desc: 'Sujet portant sur l\'énergie cinétique et les circuits électriques.', questions: ['Énergie de position', 'Puissance électrique', 'Mélanges'], themes: 'énergie électricité' },
            { id: 6, type: 'bac', mat: 'maths', annee: 2020, zone: 'Métropole', titre: 'Archives Bac Maths 2020', desc: 'Sujet de révision classique sur les fonctions exponentielles.', questions: ['Limites et Variations', 'Intégration', 'Nombres Complexes'], themes: 'fonctions complexes' },
            { id: 7, type: 'bac', mat: 'physique', annee: 2026, zone: 'Antilles', titre: 'Bac Physique 2026 (Prédiction)', desc: 'Focus sur la physique quantique et la thermodynamique.', questions: ['Dualité onde-particule', 'Premier principe thermo', 'Loi de Kepler'], themes: 'quantique thermo' }
        ];

        let currentType = 'tout';
        let currentMat = 'tout';

        function filterType(type, btn) {
            currentType = type;
            updateButtons(btn, 'type');
            render();
        }

        function filterMat(mat, btn) {
            currentMat = mat;
            updateButtons(btn, 'mat');
            render();
        }

        function updateButtons(activeBtn, group) {
            const buttons = activeBtn.parentElement.querySelectorAll('.fbtn');
            buttons.forEach(b => b.classList.remove('active'));
            activeBtn.classList.add('active');
        }

        function render() {
            const grid = document.getElementById('grid');
            const query = document.getElementById('searchBar').value.toLowerCase();
            
            const filtered = DATA.filter(item => {
                const matchType = currentType === 'tout' || item.type === currentType;
                const matchMat = currentMat === 'tout' || item.mat === currentMat;
                const matchSearch = item.titre.toLowerCase().includes(query) || item.themes.toLowerCase().includes(query);
                return matchType && matchMat && matchSearch;
            });

            grid.innerHTML = filtered.map(item => `
                <div class="card">
                    <div class="bar-${item.mat}"></div>
                    <div class="card-body">
                        <span class="tag tag-${item.type}">${item.type.toUpperCase()}</span>
                        <span class="tag tag-year">${item.annee}</span>
                        <div class="card-title">${item.titre}</div>
                        <div class="card-desc">${item.desc}</div>
                        <div class="preview-box">
                            ${item.questions.map((q, i) => `
                                <div class="preview-item">
                                    <span class="q-num">${i+1}.</span> ${q}
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-main">Sujet PDF</a>
                        <a href="#" class="btn btn-sub">Corrigé</a>
                    </div>
                </div>
            `).join('');
        }

        function search() { render(); }

        // Initial render
        render();
    </script>
</body>
</html>
